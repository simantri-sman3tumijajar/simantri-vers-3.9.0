rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /system_state/{stateId} {
      allow read, write: if true;
    }

    match /drafts/{draftKey} {
      allow read, write: if true;
    }

    match /exam_activity_logs/{logId} {
      allow read, write: if true;
    }

    match /exam_settings/{settingId} {
      allow read, write: if true;
    }

    match /exam_broadcasts/{broadcastId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
